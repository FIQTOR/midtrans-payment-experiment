# ============================================================
# Midtrans Payment Gateway — Environment Configuration
# ============================================================
# Docs: https://docs.midtrans.com/
# These are sandbox/placeholder values. NEVER commit real secrets.
# ============================================================

# ---- Server ----
PORT=4011
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5175

# ---- Midtrans credentials (from your dashboard) ----
# Midtrans dashboard: https://dashboard.sandbox.midtrans.com/
# Server Key -> used for HTTP Basic Auth against the Midtrans API.
# NEVER expose the Server Key to the browser.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
# Client Key -> safe to expose; used by Snap.js / Core API on the frontend.
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx

# Base URLs for Midtrans
# Sandbox: https://api.sandbox.midtrans.com
# Prod:    https://api.midtrans.com
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
# Snap API base (Snap.js + Snap transaction API)
# Sandbox: https://app.sandbox.midtrans.com
# Prod:    https://app.midtrans.com
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com

# Prefix for generated order ids (alphanumeric, no spaces)
MIDTRANS_ORDER_PREFIX=ORDER

# Default payment channel: snap | core (or a specific core method)
MIDTRANS_API_FLAVOR=snap

# ---- Webhook / notification ----
# Public URL where Midtrans should POST async notifications.
# Midtrans requires an HTTPS URL for production notifications.
PUBLIC_BASE_URL=http://localhost:4011

# ---- Experiment flags ----
# When true, all outbound Midtrans calls are simulated locally (no network).
# Great for UI/flow experimentation without live sandbox credentials.
MIDTRANS_MOCK_MODE=true

# ---- Rate limiting ----
# Max requests per IP per minute for /api/* (default: 120)
RATE_LIMIT_MAX=120

# ---- Persistence (optional MySQL via Sequelize) ----
# When false (default) the in-memory store is used — zero setup.
DB_ENABLED=false
# mysql (default) or sqlite (handy for tests / local quick start)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=midtrans_payments
DB_USER=root
DB_PASSWORD=
# sqlite only — file path or :memory: (used when DB_DIALECT=sqlite)
DB_STORAGE=:memory:
DB_LOGGING=false
DB_SYNC_ALTER=false
